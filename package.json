{
  "name": "nut-ai",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Nut AI — an open-source AI photo calorie tracker that never shows a number it cannot justify.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "eval",
    "tools/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --build apps/food-server && tsc -p tsconfig.json && npm --prefix apps/mobile run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:node-purity": "node scripts/check-node-purity.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:node-purity && npm run data:verify",
    "data:build": "node tools/nutrition-data/src/build.mjs",
    "data:build:full": "npm run build:packages && node tools/nutrition-data/src/build-full.mjs",
    "data:verify": "node tools/nutrition-data/src/golden-queries.mjs",
    "data:backfill-portions": "npm run build:packages && node tools/nutrition-data/src/backfill-portions.mjs",
    "build:packages": "tsc --build packages/core-schema packages/db-adapter packages/clamp packages/resolver",
    "build:server": "tsc --build apps/food-server",
    "food-server": "npm run build:server && node apps/food-server/dist/server.js",
    "postinstall": "node scripts/patch-expo-modules-jsi.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "better-sqlite3": "^13.0.2",
    "eslint": "^9.17.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "better-sqlite3@13.0.2": true
  },
  "overrides": {
    "react": "19.1.0",
    "react-native": "0.81.5",
    "metro": "0.83.3",
    "metro-config": "0.83.3",
    "metro-resolver": "0.83.3",
    "metro-runtime": "0.83.3"
  }
}
